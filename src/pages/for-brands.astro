---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout
  title="Franchisee Lead Generation for Brands | FranchiseVista"
  description="We generate, qualify and close franchisees for your brand. A ₹500 token per valid lead and a success fee only when a franchise agreement is signed."
  currentPage="for-brands"
>

<section class="hero hero-sub on-dark" aria-labelledby="h1">
  <div class="wrap">
    <div class="hero-in">
      <span class="eyebrow">For brands</span>
      <h1 id="h1">Turn enquiries into signed franchise agreements.</h1>
      <p class="lead">We generate, qualify and close franchisees for your brand, inside your terms.</p>
      <div class="btn-row">
        <a class="btn btn-gold" href="#partner">Partner with us</a>
        <a class="btn btn-ghost" href="#fees">See how fees work</a>
      </div>
    </div>
  </div>
</section>

<section class="sec" aria-labelledby="prob-h">
  <div class="wrap">
    <div class="split">
      <div class="stack" style="gap:18px">
        <span class="eyebrow">The problem</span>
        <h2 id="prob-h">Growth stalls between enquiry and signed agreement.</h2>
        <p class="lead">Most brands can attract enquiries. Fewer can follow up, qualify and close them consistently.</p>
      </div>
      <div class="stack" style="gap:16px">
        <div class="card" style="display:flex;gap:16px;align-items:center">
          <span class="tick"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#0B2D5B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
          <p style="font-weight:600;color:#0B2D5B">Enquiries arrive, but few are qualified.</p>
        </div>
        <div class="card" style="display:flex;gap:16px;align-items:center">
          <span class="tick"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#0B2D5B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
          <p style="font-weight:600;color:#0B2D5B">Follow-ups slip when the sales team is stretched.</p>
        </div>
        <div class="card" style="display:flex;gap:16px;align-items:center">
          <span class="tick"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#0B2D5B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
          <p style="font-weight:600;color:#0B2D5B">Investors lose interest before they meet your team.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="sec bg-soft" aria-labelledby="what-h">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">What we do</span>
      <h2 id="what-h">We generate, qualify and close.</h2>
      <p class="lead">One team takes a franchise lead from first interest to signed agreement.</p>
    </div>
    <div class="grid g3">
      <div class="card stack" style="gap:16px">
        <img class="ico" src={`${base}assets/icon_find.webp`} alt="" width="64" height="64" loading="lazy">
        <h3>Generate</h3>
        <p>We bring investors to your brand through five lead channels.</p>
      </div>
      <div class="card stack" style="gap:16px">
        <img class="ico" src={`${base}assets/icon_research.webp`} alt="" width="64" height="64" loading="lazy">
        <h3>Qualify</h3>
        <p>We check capacity, funds, location, intent and timeline on a call.</p>
      </div>
      <div class="card stack" style="gap:16px">
        <img class="ico" src={`${base}assets/icon_contracts.webp`} alt="" width="64" height="64" loading="lazy">
        <h3>Close</h3>
        <p>We present your offer, arrange brand calls and visits, negotiate within your terms and take the deal to signature.</p>
      </div>
    </div>
    <div class="card" style="margin-top:24px;padding:32px">
      <div class="split" style="gap:32px;align-items:center">
        <div class="stack" style="gap:10px">
          <h3 style="font-size:24px">What you keep control of</h3>
          <p>You set the terms and make every final decision. We work inside them.</p>
        </div>
        <ul class="checks two">
          <li><span class="tick"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#0B2D5B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><span>Your franchise terms, fees and territories</span></li>
          <li><span class="tick"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#0B2D5B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><span>Who you approve as a franchisee</span></li>
          <li><span class="tick"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#0B2D5B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><span>Every brand-team call and outlet visit</span></li>
          <li><span class="tick"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#0B2D5B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><span>The final agreement and its signature</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="sec" aria-labelledby="prot-h">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Lead protection</span>
      <h2 id="prot-h">Your own pipeline stays yours.</h2>
      <p class="lead">Leads are registered the moment we share them, so credit is always clear.</p>
    </div>
    <div class="tl">
      <div class="tl-i"><span class="tl-tag">At sharing</span><h3>Lead registered</h3><p>Every lead is registered when we share it with you.</p></div>
      <div class="tl-i"><span class="tl-tag">Within 2 working days</span><h3>You flag overlaps</h3><p>Tell us about any lead already in your own pipeline.</p></div>
      <div class="tl-i"><span class="tl-tag">After 2 working days</span><h3>Credited to us</h3><p>Leads you have not flagged are credited to FranchiseVista.</p></div>
      <div class="tl-i"><span class="tl-tag">For 8 months</span><h3>Protected</h3><p>Credited leads stay protected for eight months.</p></div>
    </div>
    <div class="card card-pale" style="margin-top:40px;display:flex;gap:16px;align-items:center">
      <img class="ico ico-sm" src={`${base}assets/icon_contracts.webp`} alt="" width="48" height="48" loading="lazy">
      <p style="font-weight:600;color:#0B2D5B">If a credit is disputed, we settle it on evidence.</p>
    </div>
  </div>
</section>

<section class="sec bg-soft" id="fees" aria-labelledby="fees-h">
  <div class="wrap">
    <div class="split split-r" style="align-items:center">
      <div class="stack" style="gap:22px">
        <span class="eyebrow">Simple fees</span>
        <h2 id="fees-h">A small token per lead. A success fee only on signing.</h2>
        <div class="card token" style="padding:20px 24px">
          <img class="ico ico-sm" src={`${base}assets/icon_invest.webp`} alt="" width="48" height="48" loading="lazy">
          <div>
            <b>₹500</b>
            <p>per valid lead, credited against your success fee.</p>
          </div>
        </div>
        <p><strong style="color:#0B2D5B">Example:</strong> a franchise fee of ₹2.75 lakh gives a success fee of ₹75,000.</p>
        <p>If the franchise fee is received in parts, the success fee is paid in the same proportion. Tokens are credited against the first instalment.</p>
        <p class="note">All amounts exclude GST.</p>
      </div>
      <div class="card" style="padding:32px">
        <h3 style="margin-bottom:22px;font-size:18px">Success fee by franchise fee</h3>
        <div class="fee" role="group" aria-label="Success fee by franchise fee band">
          <div class="fee-col">
            <span class="fee-val">₹50,000</span>
            <div class="fee-area"><div class="fee-bar" style="height:50%"></div></div>
            <p class="fee-lab"><strong>Up to ₹2.5 lakh</strong>Flat success fee</p>
          </div>
          <div class="fee-col">
            <span class="fee-val">Fee − ₹2 lakh</span>
            <div class="fee-area"><div class="fee-bar gold" style="height:100%"></div></div>
            <p class="fee-lab"><strong>₹2.5 – 3 lakh</strong>₹50,000 rising to ₹1,00,000</p>
          </div>
          <div class="fee-col">
            <span class="fee-val">₹1,00,000</span>
            <div class="fee-area"><div class="fee-bar" style="height:100%"></div></div>
            <p class="fee-lab"><strong>Above ₹3 lakh</strong>Flat success fee</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="sec" aria-labelledby="rep-h">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Reporting</span>
      <h2 id="rep-h">You always see where every lead stands.</h2>
    </div>
    <div class="grid g2">
      <div class="card stack" style="gap:14px">
        <img class="ico" src={`${base}assets/icon_consult.webp`} alt="" width="64" height="64" loading="lazy">
        <h3>Weekly dashboard</h3>
        <p>Leads received, qualification status, calls and visits scheduled, and deals in negotiation.</p>
      </div>
      <div class="card stack" style="gap:14px">
        <img class="ico" src={`${base}assets/icon_grow.webp`} alt="" width="64" height="64" loading="lazy">
        <h3>Monthly review</h3>
        <p>A call to review the pipeline, adjust channels and plan the month ahead.</p>
      </div>
    </div>
  </div>
</section>

<section class="sec bg-soft" aria-labelledby="need-h">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Getting started</span>
      <h2 id="need-h">What we need from you, and how we launch.</h2>
    </div>
    <div class="card" style="padding:32px;margin-bottom:56px">
      <h3 style="margin-bottom:20px">What we need from the brand</h3>
      <ul class="checks two">
        <li><span class="tick"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#0B2D5B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><span>Franchise terms and fee structure</span></li>
        <li><span class="tick"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#0B2D5B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><span>Investment levels and outlet models</span></li>
        <li><span class="tick"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#0B2D5B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><span>Approved brand presentation and images</span></li>
        <li><span class="tick"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#0B2D5B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><span>A named contact for calls and visits</span></li>
        <li><span class="tick"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#0B2D5B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><span>Outlets or sites investors can visit</span></li>
        <li><span class="tick"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#0B2D5B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><span>Quick response on every lead we share</span></li>
      </ul>
    </div>
    <div class="tl">
      <div class="tl-i"><span class="tl-tag">Week 1</span><h3>Kick-off</h3><p>Agree terms, qualification criteria and contacts.</p></div>
      <div class="tl-i"><span class="tl-tag">Weeks 1–2</span><h3>Build</h3><p>We create your landing page, listings and call scripts.</p></div>
      <div class="tl-i"><span class="tl-tag">Week 3</span><h3>Launch</h3><p>Channels and campaigns go live.</p></div>
      <div class="tl-i"><span class="tl-tag">Week 4 onward</span><h3>Close</h3><p>Qualified investors meet your team and deals move to signing.</p></div>
    </div>
  </div>
</section>

<section class="sec" id="partner" aria-labelledby="form-h">
  <div class="wrap">
    <div class="split split-r" style="align-items:start">
      <div class="stack" style="gap:18px">
        <span class="eyebrow">Partner with us</span>
        <h2 id="form-h">Tell us about your brand.</h2>
        <p class="lead">Share a few details and we will call you back to plan your launch.</p>
        <p class="cta-meta">
          <a href="tel:+919667395517">+91 96673 95517</a>
          <a href="mailto:franchisevista@growthoriginator.in">franchisevista@growthoriginator.in</a>
        </p>
      </div>
      <div class="card formcard">
        <h2>Partner with us</h2>
        <p class="note" style="margin-bottom:20px">Fields marked * are required.</p>
        <div id="partner-ok" class="ok" role="status" hidden>
          <span class="tick"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#0B2D5B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
          <div><h3>Thanks, we have your details</h3><p>We will contact you shortly to plan your launch.</p></div>
        </div>
        <form class="form" id="partner-form" novalidate>
          <div class="fld" data-field="brand">
            <label for="f-brand">Brand name <span class="req" aria-hidden="true">*</span></label>
            <input class="in" id="f-brand" name="brand" type="text" placeholder="Your brand" autocomplete="organization" aria-required="true" aria-invalid="false" aria-describedby="e-brand">
            <p class="err" id="e-brand"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:none;margin-top:1px"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5v.1"/></svg><span></span></p>
          </div>
          <div class="fld" data-field="contact">
            <label for="f-contact">Contact person <span class="req" aria-hidden="true">*</span></label>
            <input class="in" id="f-contact" name="contact" type="text" placeholder="Full name" autocomplete="name" aria-required="true" aria-invalid="false" aria-describedby="e-contact">
            <p class="err" id="e-contact"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:none;margin-top:1px"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5v.1"/></svg><span></span></p>
          </div>
          <div class="fld" data-field="phone">
            <label for="f-phone">Phone <span class="req" aria-hidden="true">*</span></label>
            <input class="in" id="f-phone" name="phone" type="tel" placeholder="+91 98XXX XXXXX" autocomplete="tel" aria-required="true" aria-invalid="false" aria-describedby="e-phone">
            <p class="err" id="e-phone"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:none;margin-top:1px"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5v.1"/></svg><span></span></p>
          </div>
          <div class="fld" data-field="email">
            <label for="f-email">Email <span class="req" aria-hidden="true">*</span></label>
            <input class="in" id="f-email" name="email" type="email" placeholder="name@company.com" autocomplete="email" aria-required="true" aria-invalid="false" aria-describedby="e-email">
            <p class="err" id="e-email"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:none;margin-top:1px"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5v.1"/></svg><span></span></p>
          </div>
          <div class="fld" data-field="city">
            <label for="f-city">City <span class="req" aria-hidden="true">*</span></label>
            <input class="in" id="f-city" name="city" type="text" placeholder="City" autocomplete="address-level2" aria-required="true" aria-invalid="false" aria-describedby="e-city">
            <p class="err" id="e-city"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:none;margin-top:1px"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5v.1"/></svg><span></span></p>
          </div>
          <div class="fld">
            <label for="f-range">Investment range <span class="help">(optional)</span></label>
            <select class="in" id="f-range" name="range">
              <option value="">Select</option>
              <option>Under ₹10 lakh</option>
              <option>₹10 – 25 lakh</option>
              <option>₹25 – 50 lakh</option>
              <option>₹50 lakh – 1 crore</option>
              <option>Above ₹1 crore</option>
            </select>
          </div>
          <div class="fld">
            <label for="f-fee">Franchise fee <span class="help">(optional)</span></label>
            <input class="in" id="f-fee" name="fee" type="text" placeholder="₹ 3,00,000">
          </div>
          <div class="fld">
            <label for="f-outlets">Outlets planned <span class="help">(optional)</span></label>
            <input class="in" id="f-outlets" name="outlets" type="number" placeholder="e.g. 25">
          </div>
          <div class="form-foot">
            <button class="btn btn-gold btn-block" type="submit">Request a call-back</button>
            <p class="note">We use these details only to contact you about FranchiseVista. See our <a href={`${base}privacy`}>Privacy and Disclaimer</a>.</p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  setupForm('partner-form', 'partner-ok', [
    { name: 'brand', type: 'text', msg: 'Enter your brand name' },
    { name: 'contact', type: 'text', msg: 'Enter a contact person' },
    { name: 'phone', type: 'phone', msg: 'Enter your phone number' },
    { name: 'email', type: 'email', msg: 'Enter your email address' },
    { name: 'city', type: 'text', msg: 'Enter your city' },
  ]);

  function setupForm(formId, okId, fields) {
    const form = document.getElementById(formId);
    const okEl = document.getElementById(okId);
    if (!form) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const errors = {};
      const PHONE = /^(\+?91[\s-]?)?[6-9]\d{4}[\s-]?\d{5}$/;
      const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      fields.forEach(({ name, type, msg }) => {
        const v = (form.elements[name]?.value || '').trim();
        if (!v) errors[name] = msg;
        else if (type === 'phone' && !PHONE.test(v)) errors[name] = 'Enter a valid 10-digit mobile number';
        else if (type === 'email' && !EMAIL.test(v)) errors[name] = 'Enter a valid email address';
      });
      fields.forEach(({ name }) => {
        const fld = form.querySelector(`[data-field="${name}"]`);
        const errEl = form.querySelector(`#e-${name}`);
        const input = form.elements[name];
        fld?.classList.remove('has-error');
        if (errEl) errEl.querySelector('span').textContent = '';
        input?.setAttribute('aria-invalid', 'false');
      });
      Object.entries(errors).forEach(([name, msg]) => {
        const fld = form.querySelector(`[data-field="${name}"]`);
        const errEl = form.querySelector(`#e-${name}`);
        const input = form.elements[name];
        fld?.classList.add('has-error');
        if (errEl) errEl.querySelector('span').textContent = msg;
        input?.setAttribute('aria-invalid', 'true');
      });
      if (Object.keys(errors).length === 0) {
        form.setAttribute('hidden', '');
        okEl?.removeAttribute('hidden');
      }
    });
  }
</script>

</Layout>
