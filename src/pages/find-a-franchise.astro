---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout
  title="Find a Franchise in India | Compare Brands | FranchiseVista"
  description="Browse franchise brands by category, investment range, city and outlet size, then enquire. Figures are indicative and set by each brand."
  currentPage="find"
>

<section class="hero hero-sub on-dark" aria-labelledby="h1">
  <div class="wrap">
    <div class="hero-in">
      <span class="eyebrow">Find a franchise</span>
      <h1 id="h1">Find the right franchise.</h1>
      <p class="lead">Compare brands by category and investment level, then enquire.</p>
    </div>
  </div>
</section>

<div class="wrap">
  <form class="card filter" id="filter-form" aria-label="Filter franchises" novalidate>
    <div class="filter-grid">
      <div class="fld">
        <label for="f-cat">Category</label>
        <select class="in" id="f-cat" name="cat">
          <option value="">All</option>
          <option value="Food &amp; Beverage">Food &amp; Beverage</option>
          <option value="Retail">Retail</option>
          <option value="Education">Education</option>
          <option value="Health &amp; Wellness">Health &amp; Wellness</option>
          <option value="Services">Services</option>
          <option value="Fitness">Fitness</option>
        </select>
      </div>
      <div class="fld">
        <label for="f-inv">Investment range</label>
        <select class="in" id="f-inv" name="inv">
          <option value="">All</option>
          <option value="u10">Under ₹10 lakh</option>
          <option value="10">₹10 – 25 lakh</option>
          <option value="25">₹25 – 50 lakh</option>
          <option value="50">Above ₹50 lakh</option>
        </select>
      </div>
      <div class="fld">
        <label for="f-where">City or state</label>
        <input class="in" id="f-where" name="where" type="text" placeholder="e.g. Mumbai or Karnataka">
      </div>
      <div class="fld">
        <label for="f-size">Outlet size</label>
        <select class="in" id="f-size" name="size">
          <option value="">All</option>
          <option value="u200">Under 200 sq ft</option>
          <option value="200">200 – 500 sq ft</option>
          <option value="500">500 – 1,000 sq ft</option>
          <option value="1000">Above 1,000 sq ft</option>
        </select>
      </div>
      <button class="btn btn-line" id="filter-reset" type="button">Reset</button>
    </div>
  </form>
</div>

<section class="sec" style="padding-top:48px" aria-labelledby="res-h">
  <div class="wrap">
    <div class="count">
      <h2 id="res-h" style="font-size:22px"><span id="count-text">Showing 12 sample brands</span></h2>
      <span class="note">Sample content. Figures are indicative, exclude GST and are set by each brand.</span>
    </div>
    <div class="grid g3" id="brand-grid"></div>
    <div class="card empty" id="empty-state" hidden>
      <img class="ico" src={`${base}assets/icon_find.webp`} alt="" width="64" height="64" loading="lazy">
      <h3>No sample brands match these filters</h3>
      <p>Try a wider investment range or clear the city.</p>
      <button class="btn btn-navy btn-sm" id="empty-reset" type="button">Clear filters</button>
    </div>
  </div>
</section>

<section class="cta" aria-labelledby="cta-h">
  <div class="wrap">
    <div class="cta-in">
      <h2 id="cta-h">Not sure which franchise fits?</h2>
      <p class="lead">Tell us your budget and location and we will suggest brands to look at.</p>
      <div class="btn-row">
        <a class="btn btn-gold" href={`${base}contact`}>Talk to us</a>
        <a class="btn btn-wa" href="https://wa.me/919667395517" target="_blank" rel="noopener noreferrer">Message on WhatsApp</a>
      </div>
      <p class="cta-meta">
        <a href="tel:+919667395517">+91 96673 95517</a>
        <a href="mailto:franchisevista@growthoriginator.in">franchisevista@growthoriginator.in</a>
      </p>
    </div>
  </div>
</section>

<script>
  const BASE = import.meta.env.BASE_URL;
  const ALL = [
    {name:'Sample Brand A',cat:'Food & Beverage',desc:'Quick-service café with a compact menu and a small counter format.',lo:10,hi:15,inv:'₹10 – 15 lakh',fee:'₹2 lakh',sz:'200',size:'200 – 500 sq ft',where:'Pan-India'},
    {name:'Sample Brand B',cat:'Retail',desc:'Lifestyle accessories store for high streets and malls.',lo:20,hi:30,inv:'₹20 – 30 lakh',fee:'₹3.2 lakh',sz:'500',size:'500 – 1,000 sq ft',where:'Delhi NCR, Maharashtra'},
    {name:'Sample Brand C',cat:'Education',desc:'After-school learning centre for primary grades.',lo:8,hi:12,inv:'₹8 – 12 lakh',fee:'₹1.5 lakh',sz:'500',size:'500 – 1,000 sq ft',where:'Pan-India'},
    {name:'Sample Brand D',cat:'Health & Wellness',desc:'Diagnostics and wellness clinic run with a partner doctor.',lo:25,hi:40,inv:'₹25 – 40 lakh',fee:'₹5 lakh',sz:'500',size:'500 – 1,000 sq ft',where:'Karnataka, Maharashtra'},
    {name:'Sample Brand E',cat:'Services',desc:'Home-services booking brand run from a small office.',lo:5,hi:8,inv:'₹5 – 8 lakh',fee:'₹1 lakh',sz:'u200',size:'Under 200 sq ft',where:'Pan-India'},
    {name:'Sample Brand F',cat:'Fitness',desc:'Neighbourhood gym with strength and group-class zones.',lo:35,hi:100,inv:'₹35 lakh – 1 crore',fee:'₹7.5 lakh',sz:'1000',size:'Above 1,000 sq ft',where:'Delhi NCR, Karnataka'},
    {name:'Sample Brand G',cat:'Food & Beverage',desc:'Street-food kiosk with a short, fast menu.',lo:4,hi:7,inv:'₹4 – 7 lakh',fee:'₹1 lakh',sz:'u200',size:'Under 200 sq ft',where:'Pan-India'},
    {name:'Sample Brand H',cat:'Retail',desc:'Large-format home and furniture showroom.',lo:50,hi:80,inv:'₹50 – 80 lakh',fee:'₹6 lakh',sz:'1000',size:'Above 1,000 sq ft',where:'Maharashtra'},
    {name:'Sample Brand I',cat:'Education',desc:'Skill-training institute for job-ready courses.',lo:15,hi:22,inv:'₹15 – 22 lakh',fee:'₹2.4 lakh',sz:'200',size:'200 – 500 sq ft',where:'Karnataka'},
    {name:'Sample Brand J',cat:'Health & Wellness',desc:'Pharmacy and wellness store with a loyalty programme.',lo:18,hi:28,inv:'₹18 – 28 lakh',fee:'₹3.5 lakh',sz:'200',size:'200 – 500 sq ft',where:'Delhi NCR, Maharashtra'},
    {name:'Sample Brand K',cat:'Services',desc:'Laundry and dry-cleaning outlets with home pickup.',lo:12,hi:18,inv:'₹12 – 18 lakh',fee:'₹2.2 lakh',sz:'200',size:'200 – 500 sq ft',where:'Delhi NCR'},
    {name:'Sample Brand L',cat:'Fitness',desc:'Yoga and wellness studio for city neighbourhoods.',lo:9,hi:14,inv:'₹9 – 14 lakh',fee:'₹2.8 lakh',sz:'500',size:'500 – 1,000 sq ft',where:'Karnataka, Maharashtra'}
  ];
  const BANDS = {u10:[0,10],'10':[10,25],'25':[25,50],'50':[50,1e9]};
  const TILE_SVG = `<svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="#F5A000" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l1.5-5h15L21 9"/><path d="M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0"/><path d="M5 12v8h14v-8"/><path d="M10 20v-5h4v5"/></svg>`;

  const grid = document.getElementById('brand-grid');
  const countText = document.getElementById('count-text');
  const emptyState = document.getElementById('empty-state');
  const catEl = document.getElementById('f-cat');
  const invEl = document.getElementById('f-inv');
  const whereEl = document.getElementById('f-where');
  const sizeEl = document.getElementById('f-size');

  function renderCard(c) {
    return `<article class="card bcard">
      <div class="bc-top">
        <div class="tile" role="img" aria-label="Sample brand logo tile">${TILE_SVG}</div>
        <span class="chip">${c.cat}</span>
      </div>
      <h3>${c.name}</h3>
      <p class="note">${c.desc}</p>
      <p class="note">${c.where} &middot; ${c.size}</p>
      <dl class="facts">
        <div><dt>Investment</dt><dd>${c.inv}</dd></div>
        <div><dt>Franchise fee</dt><dd>${c.fee}</dd></div>
      </dl>
      <a class="btn btn-navy btn-sm" href="${BASE}franchise/sample-brand">Enquire<span class="sr"> about ${c.name}</span></a>
    </article>`;
  }

  function applyFilters() {
    const cat = catEl?.value || '';
    const inv = invEl?.value || '';
    const size = sizeEl?.value || '';
    const q = (whereEl?.value || '').trim().toLowerCase();

    const list = ALL.filter(c => {
      if (cat && c.cat !== cat) return false;
      if (inv) { const b = BANDS[inv]; if (!(c.lo < b[1] && c.hi >= b[0])) return false; }
      if (size && c.sz !== size) return false;
      if (q && !(c.where.toLowerCase().includes(q) || c.where === 'Pan-India')) return false;
      return true;
    });

    if (grid) grid.innerHTML = list.map(renderCard).join('');
    if (countText) countText.textContent = list.length === 1 ? 'Showing 1 sample brand' : `Showing ${list.length} sample brands`;
    if (emptyState) {
      list.length === 0 ? emptyState.removeAttribute('hidden') : emptyState.setAttribute('hidden', '');
    }
  }

  function resetFilters() {
    if (catEl) catEl.value = '';
    if (invEl) invEl.value = '';
    if (whereEl) whereEl.value = '';
    if (sizeEl) sizeEl.value = '';
    applyFilters();
  }

  catEl?.addEventListener('change', applyFilters);
  invEl?.addEventListener('change', applyFilters);
  sizeEl?.addEventListener('change', applyFilters);
  whereEl?.addEventListener('input', applyFilters);
  document.getElementById('filter-reset')?.addEventListener('click', resetFilters);
  document.getElementById('empty-reset')?.addEventListener('click', resetFilters);
  document.getElementById('filter-form')?.addEventListener('submit', e => e.preventDefault());

  applyFilters();
</script>

</Layout>
