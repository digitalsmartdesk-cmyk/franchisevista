---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Contact FranchiseVista | Franchise Consulting India"
  description="Talk to Vikas Gupta about your franchise brand or investment. Call, WhatsApp or fill in the form and we will call you back within one business day."
  currentPage="contact"
>

<section class="hero hero-sub on-dark" aria-labelledby="h1">
  <div class="wrap">
    <div class="hero-in">
      <span class="eyebrow">Contact us</span>
      <h1 id="h1">We'd love to hear from you.</h1>
      <p class="lead">Fill in the form and we will call you back within one business day.</p>
    </div>
  </div>
</section>

<section class="sec" aria-labelledby="contact-h">
  <div class="wrap">
    <h2 id="contact-h" class="sr">Contact</h2>
    <div class="split contact-split">

      <div class="split-main">
        <form class="form" id="contact-form" novalidate aria-label="Contact form">
          <div class="fld">
            <label for="c-name">Your name <abbr title="required">*</abbr></label>
            <input class="in" id="c-name" name="name" type="text" autocomplete="name" required placeholder="Rahul Sharma">
            <span class="err" id="c-name-err" aria-live="polite"></span>
          </div>
          <div class="fld">
            <label for="c-phone">Mobile number <abbr title="required">*</abbr></label>
            <input class="in" id="c-phone" name="phone" type="tel" autocomplete="tel" required placeholder="+91 98765 43210">
            <span class="err" id="c-phone-err" aria-live="polite"></span>
          </div>
          <div class="fld">
            <label for="c-email">Email address <abbr title="required">*</abbr></label>
            <input class="in" id="c-email" name="email" type="email" autocomplete="email" required placeholder="rahul@example.com">
            <span class="err" id="c-email-err" aria-live="polite"></span>
          </div>
          <div class="fld">
            <label for="c-role">I am a</label>
            <select class="in" id="c-role" name="role">
              <option value="">Select (optional)</option>
              <option value="brand">Brand looking for franchisees</option>
              <option value="investor">Investor looking for a franchise</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="fld">
            <label for="c-city">City</label>
            <input class="in" id="c-city" name="city" type="text" autocomplete="address-level2" placeholder="Delhi">
          </div>
          <div class="fld">
            <label for="c-msg">Message</label>
            <textarea class="in" id="c-msg" name="message" rows="4" placeholder="Tell us about your brand or what you are looking for..."></textarea>
          </div>
          <button class="btn btn-gold" type="submit">Send message</button>
        </form>
        <div class="ok-panel" id="contact-ok" hidden aria-live="polite">
          <img src="/assets/icon_consult.webp" alt="" width="64" height="64" loading="lazy">
          <h3>Message received</h3>
          <p>Vikas Gupta will call you within one business day.</p>
        </div>
      </div>

      <aside class="split-side" aria-label="Contact details">
        <div class="card vikas-card">
          <div class="vikas-head">
            <div class="vikas-avatar" aria-hidden="true">VG</div>
            <div>
              <strong>Vikas Gupta</strong>
              <span class="note">Franchise Consultant</span>
            </div>
          </div>
          <ul class="contact-list">
            <li>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"/></svg>
              <a href="tel:+919667395517">+91 96673 95517</a>
            </li>
            <li>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 4-10 8L2 4"/></svg>
              <a href="mailto:franchisevista@growthoriginator.in">franchisevista@growthoriginator.in</a>
            </li>
            <li>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a7 7 0 1 1 0 14 7 7 0 0 1 0-14z"/><path d="M2 22c0-4 4.5-7 10-7s10 3 10 7"/></svg>
              <a href="https://franchisevista.growthoriginator.in" target="_blank" rel="noopener">franchisevista.growthoriginator.in</a>
            </li>
          </ul>
          <a class="btn btn-wa" href="https://wa.me/919667395517" target="_blank" rel="noopener noreferrer" style="margin-top:16px;display:flex;width:100%">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" style="margin-right:8px">
              <path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3z" fill="none" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M9 8c-.4 3.4 3.6 7.4 7 7l1-1.6-2.2-1.2-1 .9c-1-.4-2-1.4-2.4-2.4l.9-1L10.2 7z" fill="#fff"/>
            </svg>
            Message on WhatsApp
          </a>
        </div>
        <div class="card card-pale notice-card">
          <div class="notice-row">
            <img src="/assets/icon_diligence.webp" alt="" width="40" height="40" loading="lazy">
            <img src="/assets/icon_location.webp" alt="" width="40" height="40" loading="lazy">
          </div>
          <p><strong>Brands and investors both get a call-back from our team.</strong></p>
          <p class="note">We do not share your contact details with any brand or investor without your consent.</p>
        </div>
      </aside>

    </div>
  </div>
</section>

<section class="sec bg-pale" aria-labelledby="offices-h">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Our offices</span>
      <h2 id="offices-h">We operate across India.</h2>
    </div>
    <div class="grid g3">
      <article class="card office-card">
        <img src="/assets/icon_location.webp" alt="" width="40" height="40" loading="lazy">
        <h3>Noida</h3>
        <address>Ithum, Sector 62<br>Noida, Uttar Pradesh</address>
      </article>
      <article class="card office-card">
        <img src="/assets/icon_location.webp" alt="" width="40" height="40" loading="lazy">
        <h3>Bengaluru</h3>
        <address>Cinnabar Hills<br>Bengaluru, Karnataka</address>
      </article>
      <article class="card office-card">
        <img src="/assets/icon_location.webp" alt="" width="40" height="40" loading="lazy">
        <h3>Mumbai</h3>
        <address>Raheja Platinum<br>Mumbai, Maharashtra</address>
      </article>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const okEl = document.getElementById('contact-ok');
  const PHONE = /^(\+?91[\s-]?)?[6-9]\d{4}[\s-]?\d{5}$/;
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  const fields = [
    { name: 'name', msg: 'Please enter your name' },
    { name: 'phone', type: 'phone', msg: 'Please enter your mobile number' },
    { name: 'email', type: 'email', msg: 'Please enter your email address' },
  ];

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const errors: Record<string, string> = {};
    fields.forEach(({ name, type, msg }) => {
      const v = ((form?.elements as HTMLFormControlsCollection & Record<string, HTMLInputElement>)[name]?.value || '').trim();
      if (!v) errors[name] = msg;
      else if (type === 'phone' && !PHONE.test(v)) errors[name] = 'Enter a valid 10-digit mobile number';
      else if (type === 'email' && !EMAIL.test(v)) errors[name] = 'Enter a valid email address';
    });

    fields.forEach(({ name }) => {
      const inp = document.getElementById(`c-${name}`);
      const errEl = document.getElementById(`c-${name}-err`);
      if (errors[name]) {
        inp?.classList.add('has-error');
        if (errEl) errEl.textContent = errors[name];
      } else {
        inp?.classList.remove('has-error');
        if (errEl) errEl.textContent = '';
      }
    });

    if (Object.keys(errors).length === 0) {
      form.setAttribute('hidden', '');
      okEl?.removeAttribute('hidden');
    } else {
      const first = document.querySelector('.has-error');
      (first as HTMLElement)?.focus();
    }
  });
</script>

<style>
  .contact-split { display:grid; grid-template-columns:1fr 340px; gap:48px; align-items:start; }
  .vikas-card { padding:28px; }
  .vikas-head { display:flex; gap:16px; align-items:center; margin-bottom:20px; }
  .vikas-avatar { width:52px; height:52px; min-width:52px; border-radius:50%; background:var(--navy,#0D1F3C); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:18px; }
  .vikas-head strong { display:block; font-size:16px; }
  .vikas-head .note { font-size:13px; }
  .contact-list { list-style:none; padding:0; display:flex; flex-direction:column; gap:12px; }
  .contact-list li { display:flex; gap:10px; align-items:center; font-size:14px; }
  .notice-card { margin-top:16px; padding:24px; }
  .notice-row { display:flex; gap:12px; margin-bottom:12px; }
  .office-card { text-align:center; }
  .office-card img { margin:0 auto 12px; display:block; }
  .office-card address { font-style:normal; font-size:14px; color:#555; line-height:1.6; }
  .ok-panel { text-align:center; padding:40px 0; }
  .ok-panel img { margin:0 auto 16px; display:block; }
  @media (max-width:1024px) {
    .contact-split { grid-template-columns:1fr; }
  }
</style>

</Layout>
