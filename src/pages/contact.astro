---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout
  title="Contact FranchiseVista | Franchise Consulting India"
  description="Talk to our team about your franchise brand or investment. Call, WhatsApp or fill in the form and we will call you back within one business day."
  currentPage="contact"
>

<section class="hero hero-sub on-dark" aria-labelledby="h1">
  <div class="wrap">
    <div class="hero-in">
      <span class="eyebrow">Contact us</span>
      <h1 id="h1">We'd love to hear from you.</h1>
      <p class="lead">Fill in the form and we will call you back within one business day.</p>
    </div>
  </div>
</section>

<section class="sec" aria-labelledby="contact-h">
  <div class="wrap">
    <h2 id="contact-h" class="sr">Contact</h2>
    <div class="split contact-split">

      <div class="split-main">
        <form class="form" id="contact-form" novalidate aria-label="Contact form">
          <div class="fld" data-field="name">
            <label for="c-name">Your name <abbr title="required">*</abbr></label>
            <input class="in" id="c-name" name="name" type="text" autocomplete="name" aria-required="true" aria-invalid="false" aria-describedby="e-name" placeholder="Rahul Sharma">
            <p class="err" id="e-name"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:none;margin-top:1px"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5v.1"/></svg><span></span></p>
          </div>
          <div class="fld" data-field="phone">
            <label for="c-phone">Mobile number <abbr title="required">*</abbr></label>
            <input class="in" id="c-phone" name="phone" type="tel" autocomplete="tel" aria-required="true" aria-invalid="false" aria-describedby="e-phone" placeholder="+91 98765 43210">
            <p class="err" id="e-phone"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:none;margin-top:1px"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5v.1"/></svg><span></span></p>
          </div>
          <div class="fld" data-field="email">
            <label for="c-email">Email address <abbr title="required">*</abbr></label>
            <input class="in" id="c-email" name="email" type="email" autocomplete="email" aria-required="true" aria-invalid="false" aria-describedby="e-email" placeholder="rahul@example.com">
            <p class="err" id="e-email"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:none;margin-top:1px"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5v.1"/></svg><span></span></p>
          </div>
          <div class="fld">
            <label for="c-role">I am a</label>
            <select class="in" id="c-role" name="role">
              <option value="">Select (optional)</option>
              <option value="brand">Brand looking for franchisees</option>
              <option value="investor">Investor looking for a franchise</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="fld">
            <label for="c-city">City</label>
            <input class="in" id="c-city" name="city" type="text" autocomplete="address-level2" placeholder="Delhi">
          </div>
          <div class="fld">
            <label for="c-msg">Message</label>
            <textarea class="in" id="c-msg" name="message" rows="4" placeholder="Tell us about your brand or what you are looking for..."></textarea>
          </div>
          <button class="btn btn-gold" type="submit">Send message</button>
        </form>
        <div class="ok" id="contact-ok" role="status" hidden>
          <span class="tick"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#0B2D5B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
          <div><h3>Thanks, we have your message</h3><p>We will get back to you shortly.</p></div>
        </div>
      </div>

      <aside class="split-side" aria-label="Contact details">
        <div class="stack" style="gap:20px">
          <div class="card contact-det-card">
            <h2 style="font-size:24px;margin-bottom:16px">Contact details</h2>
            <ul class="checks" style="gap:6px;margin-bottom:20px">
              <li><a class="tlink" href="tel:+919667395517">+91 96673 95517</a></li>
              <li><a class="tlink" href="mailto:franchisevista@growthoriginator.in" style="white-space:normal;word-break:break-word">franchisevista@growthoriginator.in</a></li>
            </ul>
            <a class="btn btn-wa" href="https://wa.me/919667395517" target="_blank" rel="noopener noreferrer" style="display:flex">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" style="margin-right:8px">
                <path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3z" fill="none" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M9 8c-.4 3.4 3.6 7.4 7 7l1-1.6-2.2-1.2-1 .9c-1-.4-2-1.4-2.4-2.4l.9-1L10.2 7z" fill="#fff"/>
              </svg>
              WhatsApp +91 96673 95517
            </a>
          </div>
          <div class="card card-pale notice-pale" style="display:flex;gap:16px;align-items:center">
            <img class="ico ico-sm" src={`${base}assets/icon_diligence.webp`} alt="" width="40" height="40" loading="lazy" style="flex:none">
            <p style="color:#0B2D5B;font-weight:600;margin:0">Brands and investors both get a call-back from our team.</p>
          </div>
        </div>
      </aside>

    </div>
  </div>
</section>

<section class="sec bg-pale" aria-labelledby="offices-h">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">Our offices</span>
      <h2 id="offices-h">We operate across India.</h2>
    </div>
    <div class="grid g3">
      <div class="card office">
        <img class="ico ico-sm" src={`${base}assets/icon_location.webp`} alt="" width="40" height="40" loading="lazy">
        <div><h3>Ithum</h3><p>Sector 62, Noida</p></div>
      </div>
      <div class="card office">
        <img class="ico ico-sm" src={`${base}assets/icon_location.webp`} alt="" width="40" height="40" loading="lazy">
        <div><h3>Cinnabar Hills</h3><p>Bengaluru</p></div>
      </div>
      <div class="card office">
        <img class="ico ico-sm" src={`${base}assets/icon_location.webp`} alt="" width="40" height="40" loading="lazy">
        <div><h3>Raheja Platinum</h3><p>Mumbai</p></div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const okEl = document.getElementById('contact-ok');
  const PHONE = /^(\+?91[\s-]?)?[6-9]\d{4}[\s-]?\d{5}$/;
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  const fields = [
    { name: 'name', msg: 'Please enter your name' },
    { name: 'phone', type: 'phone', msg: 'Please enter your mobile number' },
    { name: 'email', type: 'email', msg: 'Please enter your email address' },
  ];

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const errors: Record<string, string> = {};
    fields.forEach(({ name, type, msg }) => {
      const v = ((form?.elements as HTMLFormControlsCollection & Record<string, HTMLInputElement>)[name]?.value || '').trim();
      if (!v) errors[name] = msg;
      else if (type === 'phone' && !PHONE.test(v)) errors[name] = 'Enter a valid 10-digit mobile number';
      else if (type === 'email' && !EMAIL.test(v)) errors[name] = 'Enter a valid email address';
    });

    fields.forEach(({ name }) => {
      const fld = document.querySelector(`[data-field="${name}"]`);
      const inp = document.getElementById(`c-${name}`);
      const errEl = document.querySelector(`#e-${name} span`);
      if (errors[name]) {
        fld?.classList.add('has-error');
        inp?.setAttribute('aria-invalid', 'true');
        if (errEl) errEl.textContent = errors[name];
      } else {
        fld?.classList.remove('has-error');
        inp?.setAttribute('aria-invalid', 'false');
        if (errEl) errEl.textContent = '';
      }
    });

    if (Object.keys(errors).length === 0) {
      form.setAttribute('hidden', '');
      okEl?.removeAttribute('hidden');
    } else {
      const first = document.querySelector('.has-error .in') as HTMLElement | null;
      first?.focus();
    }
  });
</script>

<style>
  .contact-split { display:grid; grid-template-columns:1fr 340px; gap:48px; align-items:start; }
  .contact-det-card { padding:32px; }
  .tlink { color:inherit; border-bottom:1px solid #ccc; }
  .tlink:hover { border-color:var(--gold,#F5A000); }
  .notice-pale { padding:20px 24px; }
  @media (max-width:1024px) {
    .contact-split { grid-template-columns:1fr; }
  }
</style>

</Layout>
