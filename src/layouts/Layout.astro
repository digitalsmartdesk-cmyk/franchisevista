---
interface Props {
  title: string;
  description: string;
  currentPage?: string;
}
const { title, description, currentPage = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href={`${base}styles/global.css`}>
</head>
<body>
<div class="page">

<header class="nav">
  <div class="wrap">
    <div class="nav-in">
      <a class="nav-logo" href={base} aria-label="FranchiseVista home">
        <img src={`${base}assets/logo_on_dark.webp`} alt="FranchiseVista" width="162" height="54">
      </a>
      <nav class="nav-links" aria-label="Main">
        <a href={base} aria-current={currentPage === 'home' ? 'page' : undefined}>Home</a>
        <a href={`${base}for-brands`} aria-current={currentPage === 'for-brands' ? 'page' : undefined}>For Brands</a>
        <a href={`${base}find-a-franchise`} aria-current={currentPage === 'find' ? 'page' : undefined}>Find a Franchise</a>
        <a href={`${base}about`} aria-current={currentPage === 'about' ? 'page' : undefined}>About</a>
      </nav>
      <a class="btn btn-gold" href={`${base}contact`} aria-current={currentPage === 'contact' ? 'page' : undefined}>Talk to us</a>
      <button class="burger" id="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
        <svg id="burger-open" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
        <svg id="burger-close" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none">
          <path d="M6 6l12 12M18 6L6 18"/>
        </svg>
      </button>
    </div>
  </div>
  <nav class="nav-menu" id="nav-menu" aria-label="Mobile">
    <a class="m" href={base} aria-current={currentPage === 'home' ? 'page' : undefined}>Home</a>
    <a class="m" href={`${base}for-brands`} aria-current={currentPage === 'for-brands' ? 'page' : undefined}>For Brands</a>
    <a class="m" href={`${base}find-a-franchise`} aria-current={currentPage === 'find' ? 'page' : undefined}>Find a Franchise</a>
    <a class="m" href={`${base}about`} aria-current={currentPage === 'about' ? 'page' : undefined}>About</a>
    <a class="m" href={`${base}contact`} aria-current={currentPage === 'contact' ? 'page' : undefined}>Contact</a>
    <a class="btn btn-gold" href={`${base}contact`}>Talk to us</a>
  </nav>
</header>

<main>
  <slot />
</main>

<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div class="stack">
        <img src={`${base}assets/logo_on_dark.webp`} alt="FranchiseVista" width="180" height="60" loading="lazy">
        <p>Franchise consulting and lead generation. We help brands appoint franchisees and help investors find the right franchise.</p>
      </div>
      <div>
        <h2>Pages</h2>
        <ul>
          <li><a href={base}>Home</a></li>
          <li><a href={`${base}for-brands`}>For Brands</a></li>
          <li><a href={`${base}find-a-franchise`}>Find a Franchise</a></li>
          <li><a href={`${base}about`}>About</a></li>
          <li><a href={`${base}contact`}>Contact</a></li>
          <li><a href={`${base}privacy`}>Privacy and Disclaimer</a></li>
        </ul>
      </div>
      <div>
        <h2>Contact</h2>
        <ul>
          <li>Vikas Gupta</li>
          <li><a href="tel:+919667395517">+91 96673 95517</a></li>
          <li><a href="mailto:franchisevista@growthoriginator.in">franchisevista@growthoriginator.in</a></li>
          <li><a href="https://franchisevista.growthoriginator.in" target="_blank" rel="noopener">franchisevista.growthoriginator.in</a></li>
        </ul>
      </div>
      <div>
        <h2>Offices</h2>
        <ul>
          <li>Ithum, Sector 62, Noida</li>
          <li>Cinnabar Hills, Bengaluru</li>
          <li>Raheja Platinum, Mumbai</li>
        </ul>
      </div>
    </div>
    <div class="foot-bar">
      <p>Franchise investments carry risk. Figures shown are indicative, exclude GST and are set by each brand. Nothing here promises returns, income or success.</p>
      <a class="fb" href="https://facebook.com/franchisevista" target="_blank" rel="noopener noreferrer" aria-label="FranchiseVista on Facebook">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V9H6.5v3.5H9V21h3.5v-8.5H15L15.5 9h-3V6.5c0-.3.2-.5.5-.5H15z" fill="#fff"/></svg>
        <span>facebook.com/franchisevista</span>
      </a>
      <p>© 2026 FranchiseVista</p>
    </div>
  </div>
</footer>

<a class="wa" href="https://wa.me/919667395517" target="_blank" rel="noopener noreferrer" aria-label="Chat with FranchiseVista on WhatsApp">
  <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
    <path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3z" fill="none" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/>
    <path d="M9 8c-.4 3.4 3.6 7.4 7 7l1-1.6-2.2-1.2-1 .9c-1-.4-2-1.4-2.4-2.4l.9-1L10.2 7z" fill="#fff"/>
  </svg>
  <span>WhatsApp</span>
</a>

</div>
<script>
  const burger = document.getElementById('burger');
  const menu = document.getElementById('nav-menu');
  const openIcon = document.getElementById('burger-open');
  const closeIcon = document.getElementById('burger-close');
  burger?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('open');
    menu?.classList.toggle('open', !isOpen);
    burger.setAttribute('aria-expanded', String(!isOpen));
    if (openIcon) openIcon.style.display = isOpen ? '' : 'none';
    if (closeIcon) closeIcon.style.display = isOpen ? 'none' : '';
  });
</script>
</body>
</html>
